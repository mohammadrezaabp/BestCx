# Generate a private .env with: python scripts/setup.py
# Provider credentials are optional and must remain local.
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
CX_AI_ENABLED=true
CX_AI_MODEL=deepseek/deepseek-v4.1-flash
CX_AI_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
CX_AI_DECISION_MODEL=typesafe/jev-1.13
CX_AI_DECISION_FALLBACK_MODEL=deepseek/deepseek-v4-flash
CX_STT_ENGINE=openrouter
CX_STT_MODEL=google/gemini-3.1-flash-lite

# Distinct ports keep BestCx separate from other local installations.
CX_PORT=18080
CX_CUSTOMER_PORTAL_PORT=18081
CX_CUSTOMER_PORTAL_ENABLED=true
CX_ROLES=all
CX_ADMIN_USERNAME=admin
CX_ADMIN_PASSWORD=
CX_ADMIN_DISPLAY_NAME=Administrator

# Required local credentials are generated by scripts/setup.py.
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
POSTGRES_PORT=25432
KAFKA_PORT=39092
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
