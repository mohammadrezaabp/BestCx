{
  "Roles": "all",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Ingestion": {
    "DefaultTenantId": "bestcx",
    "Environment": "development",
    "MaxBatchSize": 500,
    "MaxEventBytes": 262144,
    "RateLimitPermitPerMinute": 6000,
    "RateLimitQueueLimit": 200
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=cx;Username=cx",
    "RunMigrationsOnStartup": true,
    "MigrationsPath": "deploy/postgres/migrations"
  },
  "MockData": {
    "Enabled": false,
    "SeedPath": "deploy/postgres/mock-data.sql"
  },
  "Messaging": {
    "Provider": "kafka"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "cx-platform",
    "AutoCreateTopics": true,
    "DefaultPartitions": 6,
    "DefaultReplicationFactor": 1
  },
  "OutboxRelay": {
    "Enabled": true,
    "BatchSize": 200
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "PublicServiceUrl": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "cx-voice",
    "ForcePathStyle": true,
    "CreateBucketOnStartup": true,
    "SignedUrlTtl": "00:10:00"
  },
  "Ai": {
    "Enabled": true,
    "Provider": "openrouter",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ApiKey": "",
    "Model": "deepseek/deepseek-v4.1-flash",
    "FallbackModel": "deepseek/deepseek-v4.1-flash",
    "PromptVersion": "cx-prompt-v3",
    "Temperature": 0.1,
    "MaxTokens": 1500,
    "TaxonomyName": "cx-core",
    "DecisionModel": "typesafe/jev-1.13",
    "DecisionFallbackModel": "deepseek/deepseek-v4-flash",
    "Context": {
      "PreviousEventCount": 20,
      "LookbackWindow": "00:30:00",
      "IncludeOpenSupportCase": true,
      "IncludeLatestFeedback": true
    },
    "Review": {
      "ConfidenceThreshold": 0.75,
      "ReviewCriticalSeverity": true,
      "ReviewUnknownCategory": true,
      "QaSampleRate": 0.05
    }
  },
  "Voice": {
    "ObjectKeyPrefix": "cx",
    "DefaultLanguage": "en",
    "AutoTranscribeOnReady": true,
    "AutoAnalyzeOnTranscript": true,
    "Stt": {
      "Engine": "openrouter",
      "ApiKey": "",
      "DeepgramApiKey": "",
      "Model": "google/gemini-3.1-flash-lite",
      "FallbackModel": "google/gemini-2.5-flash-lite"
    }
  },
  "Redaction": {
    "Enabled": true
  },
  "Voip": {
    "Provider": "http",
    "AuthMode": "none",
    "AllowedRecordingHosts": []
  },
  "Podium": {
    "Enabled": false,
    "UseMockData": false,
    "BaseUrl": "https://connector.example.invalid",
    "AuthMode": "apikey",
    "Routes": {
      "Health": null,
      "Changes": null,
      "Customer": null,
      "Product": null
    }
  },
  "Auth": {
    "Mode": "login",
    "MockSubject": "demo-admin",
    "MockTenantId": "bestcx",
    "ApiKeys": [],
    "Users": [
      {
        "Username": "admin",
        "Password": "",
        "DisplayName": "Administrator",
        "TenantId": "bestcx",
        "Roles": [
          "admin"
        ]
      }
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
