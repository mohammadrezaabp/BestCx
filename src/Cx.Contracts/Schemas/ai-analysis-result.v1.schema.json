{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connector.example.invalid/cx/schemas/ai-analysis-result.v1.schema.json",
  "title": "AI Analysis Result v1",
  "type": "object",
  "required": [
    "sentiment",
    "intent",
    "category",
    "severity",
    "resolution_status",
    "summary",
    "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_version": { "type": "string" },
    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative", "mixed", "unknown"] },
    "intent": { "type": "string", "minLength": 1, "maxLength": 128 },
    "category": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subcategory": { "type": ["string", "null"], "maxLength": 128 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "journey_stage": { "type": ["string", "null"], "maxLength": 64 },
    "resolution_status": { "type": "string", "enum": ["resolved", "partially_resolved", "unresolved", "unknown"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "action_items": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 20 },
    "mentioned_products": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 20 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "call_reason": { "type": ["string", "null"], "maxLength": 256 },
    "follow_up_required": { "type": ["boolean", "null"] },
    "key_moments": {
      "type": ["array", "null"],
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "type", "summary"],
        "additionalProperties": false,
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "type": {
            "type": "string",
            "enum": ["problem_statement", "complaint", "resolution", "commitment", "escalation", "other"]
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
